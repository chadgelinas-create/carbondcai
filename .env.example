# Safe local-development examples only. Copy to .env and change as needed.
SKID2_COMPOSE_PROJECT=skid2
SKID2_ENVIRONMENT=development
SKID2_SERVICE_NAME=backend
SKID2_SERVICE_HOST=0.0.0.0
SKID2_SERVICE_PORT=8000
SKID2_LOG_LEVEL=INFO
SKID2_SIMULATION_ENABLED=true
SKID2_SIMULATION_STEP_SECONDS=1.0
SKID2_SIMULATION_PROFILE=stage0
SKID2_SIMULATION_SEED=0
SKID2_PROTOCOL_ROOT=protocol
SKID2_MODBUS_ENABLED=true
SKID2_MODBUS_BIND_HOST=0.0.0.0
SKID2_MODBUS_CLIENT_HOST=127.0.0.1
SKID2_MODBUS_PORT=1502
SKID2_MODBUS_BA1_ID=1
SKID2_MODBUS_CNVTR1_ID=2
SKID2_MODBUS_CNVTR2_ID=3
SKID2_MODBUS_DC600_ID=4
SKID2_MODBUS_ST4_ID=5
SKID2_MODBUS_ST5_ID=6
SKID2_MODBUS_ST6_ID=7
SKID2_MODBUS_BANK_PATH=generated/protocol/simulator/register_banks.json
SKID2_SYNTHETIC_ENABLED=true
SKID2_SYNTHETIC_INTERVAL_SECONDS=1.0
SKID2_FRESHNESS_THRESHOLD_SECONDS=3.0
# Zero means unlimited. A positive value is only for deterministic test interruption.
SKID2_SYNTHETIC_MAX_SAMPLES=0
SKID2_DATA_SOURCE=sim
SKID2_EMS_ENABLED=true
SKID2_EMS_POLL_SECONDS=1.0
SKID2_AUTH_SECRET=local-development-auth-secret # pragma: allowlist secret
# Optional comma-separated browser origins for CORS (Netlify demos, tunnels, etc.)
SKID2_CORS_ORIGINS=
# Public UI origin used in invitation emails. Defaults to SKID2_BROWSER_ORIGIN.
SKID2_PUBLIC_APP_URL=http://127.0.0.1:5174
# Outbound SMTP for authorization emails. Leave host empty to store mail under data/mail/.
SKID2_SMTP_HOST=
SKID2_SMTP_PORT=587
SKID2_SMTP_USERNAME=
SKID2_SMTP_PASSWORD=
SKID2_SMTP_FROM=Skid 2 EMS <noreply@carbondc.io>
SKID2_SMTP_STARTTLS=true
SKID2_MAIL_DIR=data/mail

SKID2_DATABASE_NAME=skid2
SKID2_DATABASE_USER=skid2
SKID2_DATABASE_PASSWORD=local-development-only # pragma: allowlist secret
SKID2_DATABASE_URL=postgresql+psycopg://skid2:local-development-only@db:5432/skid2 # pragma: allowlist secret

# Host-only development bindings. Containers use their internal ports.
SKID2_DB_HOST_PORT=5432
SKID2_API_HOST_PORT=8000
SKID2_PANEL_HOST_PORT=5173
SKID2_MODBUS_HOST_PORT=1502

# Staging-only overrides (compose.staging.yaml); local Compose stays localhost-only.
# Use the server's public IP/DNS name for the address shown to desktop Modbus clients.
# SKID2_MODBUS_PUBLIC_HOST=your-staging-host
# Staging publishes TCP 1502; restrict inbound access to approved client IPs.
# SKID2_MODBUS_PUBLISH_HOST=0.0.0.0
